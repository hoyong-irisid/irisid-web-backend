{
  "key": "group_irisid_site_options",
  "title": "Site Settings",
  "fields": [
    {
      "key": "field_irisid_opt_header_logo",
      "label": "Header Logo",
      "name": "header_logo",
      "type": "image",
      "return_format": "array",
      "show_in_graphql": 1,
      "graphql_field_name": "headerLogo"
    },
    {
      "key": "field_irisid_opt_header_cta",
      "label": "Header CTA",
      "name": "header_cta",
      "type": "link",
      "return_format": "array",
      "show_in_graphql": 1,
      "graphql_field_name": "headerCta"
    },
    {
      "key": "field_irisid_opt_kb_url",
      "label": "Knowledge Base URL (Salesforce)",
      "name": "knowledge_base_url",
      "type": "url",
      "instructions": "External Salesforce KB – not hosted on irisid.com",
      "show_in_graphql": 1,
      "graphql_field_name": "knowledgeBaseUrl"
    },
    {
      "key": "field_irisid_opt_contact_phone",
      "label": "Phone",
      "name": "contact_phone",
      "type": "text",
      "show_in_graphql": 1,
      "graphql_field_name": "contactPhone"
    },
    {
      "key": "field_irisid_opt_contact_email",
      "label": "Email",
      "name": "contact_email",
      "type": "email",
      "show_in_graphql": 1,
      "graphql_field_name": "contactEmail"
    },
    {
      "key": "field_irisid_opt_footer_copy",
      "label": "Copyright",
      "name": "copyright",
      "type": "text",
      "show_in_graphql": 1,
      "graphql_field_name": "copyright"
    },
    {
      "key": "field_irisid_opt_hero_mode",
      "label": "Homepage hero mode",
      "name": "homepage_hero_mode",
      "type": "select",
      "choices": {
        "1": "Option 1 – Bézier Lines",
        "2": "Option 2 – Anomalous Matter",
        "3": "Option 3 – Digital Blue Face Video",
        "4": "Option 4 – GradFlow Silk",
        "5": "Option 5 – HUD Scan"
      },
      "default_value": "1",
      "return_format": "value",
      "instructions": "Used when no custom hero image/video URL is set. Managed from /admin Settings.",
      "show_in_graphql": 1,
      "graphql_field_name": "homepageHeroMode"
    },
    {
      "key": "field_irisid_opt_hero_image_url",
      "label": "Homepage hero image URL",
      "name": "homepage_hero_image_url",
      "type": "url",
      "instructions": "Optional full-bleed hero image. Overrides the visual mode background when set.",
      "show_in_graphql": 1,
      "graphql_field_name": "homepageHeroImageUrl"
    },
    {
      "key": "field_irisid_opt_hero_video_url",
      "label": "Homepage hero video URL",
      "name": "homepage_hero_video_url",
      "type": "url",
      "instructions": "Optional looping hero video URL. Takes priority over image when both are set.",
      "show_in_graphql": 1,
      "graphql_field_name": "homepageHeroVideoUrl"
    },
    {
      "key": "field_irisid_opt_aslan_chat",
      "label": "ASLAN chatbot enabled",
      "name": "aslan_chat_enabled",
      "type": "true_false",
      "ui": 1,
      "default_value": 1,
      "instructions": "Public site chatbot widget. Server env ASLAN_CHAT_ENABLED=0 still forces off.",
      "show_in_graphql": 1,
      "graphql_field_name": "aslanChatEnabled"
    }
  ],
  "location": [
    [
      {
        "param": "options_page",
        "operator": "==",
        "value": "irisid-site-settings"
      }
    ]
  ],
  "active": true,
  "show_in_graphql": 1,
  "graphql_field_name": "siteSettingsFields"
}
