      "rows": 3,
      "new_lines": "br",
      "show_in_graphql": 1,
      "graphql_field_name": "noticeBody"
    },
    {
      "key": "field_irisid_notice_cta_enabled",
      "label": "Show CTA button",
      "name": "cta_enabled",
