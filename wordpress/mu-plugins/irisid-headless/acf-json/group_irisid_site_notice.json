      "type": "date_picker",
      "instructions": "Eastern Time (America/New_York). Empty = no end date.",
      "display_format": "Y-m-d",
      "return_format": "Y-m-d",
      "first_day": 0,
      "show_in_graphql": 1,
      "graphql_field_name": "endsAt"
    },
    {
      "key": "field_irisid_notice_dismiss_days",
      "label": "Hide days after closing",
      "name": "dismiss_days",
      "type": "number",
      "instructions": "If a visitor closes the notice, it stays hidden for this many days (1\u2013365, default 7). Saving the notice again (title/body/schedule change) resets dismiss and shows it again.",
      "default_value": 7,
      "min": 1,
      "max": 365,
      "step": 1,
      "required": 1,
      "show_in_graphql": 1,
      "graphql_field_name": "dismissDays"
    }
