      "choices": {
        "left": "Left",
        "center": "Center",
        "right": "Right"
      },
      "default_value": "left",
      "return_format": "value",
      "layout": "horizontal",
      "required": 1,
      "show_in_graphql": 1,
      "graphql_field_name": "textAlign"
    },
    {
      "key": "field_irisid_notice_tab_schedule",
      "label": "Schedule",
      "type": "tab"
    },
    {
      "key": "field_irisid_notice_schedule_presets",
      "label": "Exposure period",
      "name": "",
      "type": "message",
      "message": "<p style=\"margin:0;\">Start date begins at 00:00 ET. End date ends at 23:59 ET. Leave both empty for always-on while published. When multiple notices overlap on a page, the site rotates them every 5 seconds with a fade.</p>"
    },
    {
      "key": "field_irisid_notice_starts_at",
      "label": "Start date",
      "name": "starts_at",
      "type": "date_picker",
      "instructions": "Eastern Time (America/New_York). Empty = start when published.",
      "display_format": "Y-m-d",
      "return_format": "Y-m-d",
      "first_day": 0,
      "show_in_graphql": 1,
      "graphql_field_name": "startsAt"
