      "instructions": "Search and select an event. When set, the CTA button (if enabled) links to that event's page automatically, overriding the CTA URL field below. Title and Notice body are always shown exactly as entered.",
      "post_type": ["resource"],
      "taxonomy": ["resource_type:events"],
      "filters": ["search"],
      "elements": [],
      "min": 0,
      "max": 1,
      "return_format": "object",
      "show_in_graphql": 1,
      "graphql_field_name": "linkedEvent"
    },
