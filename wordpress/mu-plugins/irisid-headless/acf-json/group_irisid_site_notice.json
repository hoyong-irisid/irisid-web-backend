      "conditional_logic": [
        [
          {
            "field": "field_irisid_notice_cta_enabled",
            "operator": "==",
            "value": "1"
          }
        ]
      ],
      "show_in_graphql": 1,
      "graphql_field_name": "ctaLabel"
