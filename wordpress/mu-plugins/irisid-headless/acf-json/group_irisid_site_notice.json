      "instructions": "Internal path (e.g. /resources/events/bmic8-2026/) or full URL (https://…). Ignored when Linked event above is set – the event's own page is used instead.",
      "placeholder": "/resources/events/bmic8-2026/",
      "conditional_logic": [
        [
          {
            "field": "field_irisid_notice_cta_enabled",
            "operator": "==",
            "value": "1"
          }
        ]
      ],
      "show_in_graphql": 1,
      "graphql_field_name": "ctaUrl"
