      "conditional_logic": [
        [
          {
            "field": "field_irisid_notice_cta_enabled",
            "operator": "==",
            "value": "1"
          }
        ]
      ],
      "show_in_graphql": 1,
      "graphql_field_name": "ctaLabel"
    },
    {
      "key": "field_irisid_notice_cta_url",
      "label": "CTA URL",
      "name": "cta_url",
      "type": "text",
      "instructions": "Internal path (e.g. /solutions/access-control/) or full URL (https://\u2026).",
      "placeholder": "/solutions/access-control/",
      "conditional_logic": [
        [
          {
            "field": "field_irisid_notice_cta_enabled",
            "operator": "==",
            "value": "1"
          }
        ]
      ],
      "show_in_graphql": 1,
      "graphql_field_name": "ctaUrl"
