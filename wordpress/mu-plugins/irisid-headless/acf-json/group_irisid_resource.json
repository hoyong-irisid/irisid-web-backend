{
  "key": "group_irisid_resource",
  "title": "Resource",
  "fields": [
    {
      "key": "field_irisid_resource_layout",
      "label": "Type",
      "name": "resource_layout",
      "type": "radio",
      "instructions": "Switch tabs to change the fields for this resource.",
      "choices": {
        "list": "List",
        "video": "Video",
        "file": "File",
        "event": "Event"
      },
      "default_value": "list",
      "return_format": "value",
      "layout": "horizontal",
      "required": 1,
      "show_in_graphql": 1,
      "graphql_field_name": "resourceLayout"
    },
    {
      "key": "field_irisid_resource_kind",
      "label": "Category",
      "name": "resource_kind",
