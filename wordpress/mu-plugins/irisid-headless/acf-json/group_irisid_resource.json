      "conditional_logic": [
        [
          {
            "field": "field_irisid_resource_layout",
            "operator": "==",
            "value": "list"
          }
        ],
        [
          {
            "field": "field_irisid_resource_layout",
            "operator": "==",
            "value": "video"
          }
        ]
      ],
      "show_in_graphql": 1,
      "graphql_field_name": "displayDate"
