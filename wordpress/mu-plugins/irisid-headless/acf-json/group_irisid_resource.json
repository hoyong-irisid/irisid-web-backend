      "instructions": "Where this post lives on the site. Check every category that should list it.",
      "required": 1,
      "taxonomy": "resource_type",
      "field_type": "checkbox",
      "allow_null": 0,
      "add_term": 0,
      "save_terms": 1,
      "load_terms": 1,
      "return_format": "id",
      "multiple": 1,
      "show_in_graphql": 0
    },
    {
      "key": "field_irisid_resource_title",
      "label": "Title",
      "name": "resource_title",
